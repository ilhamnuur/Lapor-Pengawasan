# Salin file ini menjadi .env lalu sesuaikan nilainya.
# .env TIDAK boleh di-commit ke git (sudah masuk .gitignore).

# Port aplikasi (default 3100)
PORT=3100
NODE_ENV=production

# Zona waktu: penting agar tanggal pelaksanaan tidak bergeser satu hari
TZ=Asia/Jakarta

# Koneksi PostgreSQL
DB_HOST=10.10.10.195
DB_PORT=5432
DB_NAME=lapor
DB_USER=casaos
DB_PASSWORD=ubah-password-ini

# Wajib diisi. Buat nilai acak, contoh:
#   openssl rand -hex 32
# Jika diganti, semua user harus login ulang.
JWT_SECRET=ubah-dengan-string-acak-panjang

# --- Chrome Docker berbasis Kasm (docker-compose.kasm-chrome.yml) ---
# Tidak dipakai oleh aplikasi Lapor Pengawasan; hanya untuk container Chrome
# yang diakses lewat browser pada https://<server>:5678.
# Wajib diisi (user login: kasm_user, minimal 6 karakter). Buat dengan:
#   openssl rand -base64 24
# Selama masih kosong, docker compose akan menolak menjalankan service ini.
KASM_VNC_PW=
KASM_CHROME_PORT=5678
KASM_VNC_RESOLUTION=1280x800
# Aktifkan bila akses hanya lewat reverse proxy di server yang sama:
# KASM_CHROME_BIND=127.0.0.1
